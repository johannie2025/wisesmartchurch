{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wise Design Smart Church System",
  "version": "0.1.0",
  "identifier": "com.wisedesign.wisechurch",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [
      { "label": "main", "title": "Wise Design Smart Church System", "width": 1440, "height": 860, "minWidth": 640, "minHeight": 420, "useHttpsScheme": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["bin/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
